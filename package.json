{
  "name": "@le/ui-kit",
  "version": "0.1.0",
  "private": false,
  "description": "Stencil design system for Local Events \u2014 tokens, badges, post card",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/components/index.js",
  "module": "./dist/components/index.js",
  "types": "./dist/components/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./post-detail": {
      "types": "./dist/components/le-post-detail.d.ts",
      "import": "./dist/components/le-post-detail.js"
    },
    "./ask": {
      "types": "./dist/components/le-ask.d.ts",
      "import": "./dist/components/le-ask.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "stencil build",
    "dev": "NODE_ENV=development stencil build --watch --serve",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "stencil build"
  },
  "dependencies": {
    "@le/shared": "github:aruhyak/localevents-shared#v0.17.0"
  },
  "devDependencies": {
    "@stencil/core": "^4.22.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
